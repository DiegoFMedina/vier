# Variables usadas por docker-compose.yml. Copia este archivo como ".env" y ajusta según el entorno.

POSTGRES_USER=vier
POSTGRES_PASSWORD=vier
POSTGRES_DB=vier

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

MINIO_ACCESS_KEY=vier
MINIO_SECRET_KEY=vier12345
MINIO_BUCKET=vier-capturas

# Host:puerto de MinIO alcanzable desde el navegador (para ver fotos/documentos adjuntos).
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000

CORS_ORIGIN=http://localhost:8080
