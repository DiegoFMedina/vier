generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  TECNICO
}

enum LevantamientoEstado {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nombre       String
  role         Role     @default(TECNICO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  levantamientos Levantamiento[] @relation("CreadoPor")
  capturas       Captura[]

  @@map("users")
}

model Levantamiento {
  id          String              @id @default(uuid())
  titulo      String
  descripcion String?
  direccion   String?
  estado      LevantamientoEstado @default(PENDIENTE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  creadoPorId String
  creadoPor   User   @relation("CreadoPor", fields: [creadoPorId], references: [id])

  capturas Captura[]

  @@map("levantamientos")
}

model Captura {
  id             String   @id @default(uuid())
  fileKey        String
  fileName       String
  mimeType       String
  size           Int
  tipo           String   @default("foto")
  notas          String?
  latitud        Float?
  longitud       Float?
  createdAt      DateTime @default(now())

  levantamientoId String
  levantamiento   Levantamiento @relation(fields: [levantamientoId], references: [id], onDelete: Cascade)

  subidoPorId String
  subidoPor   User   @relation(fields: [subidoPorId], references: [id])

  @@map("capturas")
}
