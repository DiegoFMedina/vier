NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://vier:vier@localhost:5432/vier?schema=public"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Endpoint alcanzable desde el navegador del usuario (para las URLs firmadas de las fotos/documentos).
# En docker-compose el backend habla con "minio:9000" internamente, pero el navegador necesita "localhost:9000".
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=vier
MINIO_SECRET_KEY=vier12345
MINIO_BUCKET=vier-capturas

CORS_ORIGIN=http://localhost:8080
